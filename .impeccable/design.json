  "narrative": {
    "northStar": "L2-1 浅色仪器",
    "overview": "白瓷珐琅面板承载任务，凹井盛放数据，刻字标明用途，机加工键执行动作，LED 报告状态。用户明确要求严格贴近 L2-1 HTML 示例的质感和密度，并否决层层白卡与浅蓝框拼接的旧实现。",
    "keyCharacteristics": [
      "一层主要机箱与一层功能凹井",
      "连续读面，不再给详情套卡",
      "文字导航与紧凑控制",
      "真实数据与原有操作保留"
    ],
    "rules": [
      {
        "name": "The Semantic Color Rule",
        "body": "使用现有语义变量，不把类型色扩展为大面积装饰。",
        "section": "colors"
      },
      {
        "name": "The Single Chassis Rule",
        "body": "页面外壳承担整体深度，详情正文不重复包卡。",
        "section": "layout"
      }
    ],
    "dos": [
      "Do 以已选 L2-1 HTML 为视觉依据，使用真实宿主数据。",
      "Do 保留键盘焦点、字号偏好、主题与窄屏操作。",
      "Do 区分功能检查、截图复审与用户验收。"
    ],
    "donts": [
      "Don't 通过重复外框、横幅与卡片叠层制造分区。",
      "Don't 以静态演示替代真实交互。",
      "Don't 把浅色截图复审推广为全主题、全状态的验收。"
    ]
  }
}
