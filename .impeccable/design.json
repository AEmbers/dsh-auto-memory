  "narrative": {
    "northStar": "C 原生桌面 · 白浅蓝记忆工作空间",
    "overview": "采用用户明确选择的 C 系列参考：白色内容面、浅蓝环境、深蓝文字与清晰蓝色操作。欢迎流程保留独立插画与舒展节奏，工作页以紧凑分区和可读信息行承载日常操作。\n\n运行于 DSH Web 宿主，原生桌面是视觉方向。工作台、宿主设置、轻面板和浮层共享语义主题，各自保有容器与密度。",
    "keyCharacteristics": [
      "白浅蓝表面与深蓝文本",
      "欢迎精致、工作页紧凑",
      "独立宿主表面共享主题",
      "真实内容和状态优先"
    ],
    "rules": [
      {
        "name": "The Shared Theme Rule",
        "body": "每个独立挂载或 portal 表面携带主题边界，不能依赖工作台恰好在场。",
        "section": "colors"
      },
      {
        "name": "The Different Density Rule",
        "body": "共享色彩与控件语言，按欢迎、工作页和轻面板分别安排空间。",
        "section": "layout"
      }
    ],
    "dos": [
      "Do 复用语义变量、真实字段和现有可操作组件。",
      "Do 在独立宿主设置、轻面板及浅深主题中分别检查正文和操作区。",
      "Do 保留焦点轮廓、字号偏好、窄屏滚动与减少动态效果支持。"
    ],
    "donts": [
      "Don't 将参考截图或图片中的文字当作可操作界面。",
      "Don't 将参考示例数字、共享样式或 coverage 映射当作全量验收。"
    ]
  }
}
